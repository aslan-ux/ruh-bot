# Токен от @BotFather (после /revoke — новый!)
BOT_TOKEN=123456:ABC-DEF...

# Публичный HTTPS-адрес мини-аппа (из ngrok/cloudflared в деве, домен в проде)
WEBAPP_URL=https://your-tunnel.ngrok-free.app

# Пароль для входа в админку (/admin.html). Придумай свой.
ADMIN_KEY=pridumaj-svoj-parol

# Порт локального сервера
PORT=3000
